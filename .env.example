# Configuration de YT-RAG Local : copier ce fichier en .env, puis décommenter uniquement ce qui change.
# Une variable absente prend la valeur par défaut indiquée ici. Redémarrer le serveur après une modification.

# ── YouTube ─────────────────────────────────────────────────────────────────────────────────────────
# Si YouTube répond « Sign in to confirm you're not a bot », yt-dlp lit YouTube avec les cookies d'un
# navigateur connecté à un compte YouTube. Sous Windows, préférer Firefox : Chrome, Edge et Brave
# verrouillent et chiffrent leurs cookies. Exemples : firefox, firefox:NOM_DU_PROFIL.
# YT_DLP_COOKIES_FROM_BROWSER=firefox
# Ou un fichier exporté au format Netscape (un seul des deux réglages).
# YT_DLP_COOKIES=cookies.txt

# ── Transcription ───────────────────────────────────────────────────────────────────────────────────
# Langue parlée : fr, en, de, es, it, pt, ru, zh, yue, ou auto pour la détection automatique.
# ASR_LANGUAGE=fr
# title : titre et chaîne transmis comme contexte (noms propres, marques). none : aucun contexte.
# ASR_CONTEXT=title
# torch.compile du décodeur Qwen3-ASR : audio environ 2,8 fois plus rapide. Compilation au démarrage du
# worker (environ 5 min la toute première fois, 1 min 30 s ensuite) : rentable dès 8 minutes d'audio.
# ASR_COMPILE=true

# ── Analyse visuelle ────────────────────────────────────────────────────────────────────────────────
# Images (une par seconde) par séquence analysée ensemble.
# VIDEO_GROUP_FRAMES=7
# Plus grand côté des captures, et pixels transmis au modèle par image. Plus haut : petites écritures
# mieux lues, mais plus de mémoire et de temps.
# FRAME_MAX_SIDE=1280
# VISION_MAX_PIXELS=393216
# VISION_MAX_NEW_TOKENS=1024

# ── Fichiers et journal ─────────────────────────────────────────────────────────────────────────────
# false : les JSON de cache sont gardés, MP4/WAV/JPEG sont supprimés après un export réussi.
# KEEP_MEDIA=false
# info : étapes, progression et problèmes dans le terminal (le fichier JSONL garde tout).
# debug : chaque événement technique, plus les requêtes HTTP. warn / error : problèmes seulement.
# LOG_LEVEL=info
# Dossiers de données, toujours à l'intérieur du dossier du projet.
# OUTPUT_DIR=outputs
# CACHE_DIR=cache
# MODELS_DIR=models
# LOGS_DIR=logs

# ── Avancé : modèles et moteurs ─────────────────────────────────────────────────────────────────────
# Changer un modèle ou un découpage invalide les caches correspondants.
# ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf
# ASR_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B-hf
# Morceaux audio sauvegardés un par un (points de reprise), avec un chevauchement aux frontières.
# AUDIO_CHUNK_SECONDS=60
# AUDIO_OVERLAP_SECONDS=1
# VISION_MODEL=Qwen/Qwen3.5-9B
# llama_cpp : moteur CUDA et GGUF Q4_K_M verrouillés sous NATIVE_VISION_DIR.
# transformers : moteur HF en NF4 ou BF16 (VISION_QUANTIZATION), poids HF nécessaires.
# VISION_BACKEND=llama_cpp
# NATIVE_VISION_DIR=models/native-vision
# VISION_QUANTIZATION=nf4
# DEVICE=cuda:0

# ── Avancé : réseau, programmes et délais ───────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=3002
# CLIENT_PORT=5174
# Trouvés automatiquement dans .venv, sinon dans le PATH.
# PYTHON_BINARY=.venv/Scripts/python.exe
# YT_DLP_BINARY=yt-dlp
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
# YT_DLP_TIMEOUT_MS=120000
# DOWNLOAD_TIMEOUT_MS=1800000
# WORKER_TIMEOUT_MS=14400000
# CATALOG_MAX_VIDEOS=10000
